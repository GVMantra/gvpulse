<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <collectionProcessors>
        <name>Filter_OLIs_with_required_Family</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter OLIs with required Family</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_OLIs_with_required_Family</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_OLIs</collectionReference>
        <conditionLogic>formula_evaluates_to_true</conditionLogic>
        <connector>
            <targetReference>Check_if_Line_items_are_null</targetReference>
        </connector>
        <formula>ISPICKVAL( {!currentItem_Filter_OLIs_with_required_Family.Product2.Family} , &apos;Support&apos; ) || ISPICKVAL( {!currentItem_Filter_OLIs_with_required_Family.Product2.Family} , &apos;Subscription&apos; )</formula>
    </collectionProcessors>
    <customErrors>
        <name>Make_start_date_required</name>
        <label>Make start date required</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Start date is required</errorMessage>
            <fieldSelection>Start_Date__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_if_Line_items_are_null</name>
        <label>Check if Line items are null</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No line item exists</defaultConnectorLabel>
        <rules>
            <name>Line_Items_exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Filter_OLIs_with_required_Family</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Filter_OLIs_with_required_Family</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Make_start_date_required</targetReference>
            </connector>
            <label>Line Items exists</label>
        </rules>
    </decisions>
    <description>Make start date required if there exists at least 1 product from Subscription or Support Family</description>
    <environments>Default</environments>
    <interviewLabel>Opportunity-BEFORE-Start Date Required Validation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity-BEFORE-Start Date Required Validation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get all Line Items related to triggering opportunity</description>
        <name>Get_OLIs</name>
        <label>Get OLIs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Filter_OLIs_with_required_Family</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_OLIs</targetReference>
        </connector>
        <filterFormula>AND( NOT({!$Setup.Bypass_validations__c.Bypass_Flows__c}), ISNULL({!$Record.Start_Date__c}) )</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>currentItem_Filter_OLIs_with_required_Family</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>OpportunityLineItem</objectType>
    </variables>
</Flow>
